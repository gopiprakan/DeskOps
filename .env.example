# Local development defaults only. Never commit your actual .env file.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://deskops:deskops_dev@localhost:5432/deskops
REDIS_URL=redis://localhost:6379

# Configure these when the authentication implementation is added.
